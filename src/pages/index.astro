        <script is:inline>
            function switchBehindMedia(tab) {
                const teamImg = document.getElementById('imgBehindTeam');
                const archImg = document.getElementById('imgBehindArch');
                const teamTab = document.getElementById('tabBehindTeam');
                const archTab = document.getElementById('tabBehindArch');
                const caption = document.getElementById('captionBehindMedia');

                if (tab === 'team') {
                    if (teamImg) teamImg.classList.remove('hidden');
                    if (archImg) archImg.classList.add('hidden');
                    if (teamTab) {
                        teamTab.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-primary text-white shadow-xs cursor-pointer';
                    }
                    if (archTab) {
                        archTab.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-white dark:bg-surface hover:bg-surface-container text-on-surface-variant cursor-pointer border border-outline-variant/30';
                    }
                    if (caption) caption.textContent = 'Dokumentasi tim mahasiswa Ilmu Komunikasi UBSI di PR Awards 2025';
                } else {
                    if (teamImg) teamImg.classList.add('hidden');
                    if (archImg) archImg.classList.remove('hidden');
                    if (teamTab) {
                        teamTab.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-white dark:bg-surface hover:bg-surface-container text-on-surface-variant cursor-pointer border border-outline-variant/30';
                    }
                    if (archTab) {
                        archTab.className = 'px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-primary text-white shadow-xs cursor-pointer';
                    }
                    if (caption) caption.textContent = 'Alur arsitektur chatbot AI, Supabase pgvector, dan automasi n8n';
                }
            }

            function openArchiveModal() {
                const modal = document.getElementById('projectArchiveModal');
                if (modal) modal.classList.add('active');
            }
            function closeArchiveModal() {
                const modal = document.getElementById('projectArchiveModal');
                if (modal) {
                    modal.classList.remove('active');
                    localStorage.setItem('lisa_archive_notice_seen', 'true');
                }
            }
            document.addEventListener('DOMContentLoaded', () => {
                const modal = document.getElementById('projectArchiveModal');
                if (modal) {
                    modal.addEventListener('click', (e) => {
                        if (e.target === modal) closeArchiveModal();
                    });
                }
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
                        closeArchiveModal();
                    }
                });
                if (!localStorage.getItem('lisa_archive_notice_seen')) {
                    setTimeout(() => {
                        openArchiveModal();
                    }, 800);
                }
            });
        </script>

    </body>
</html>


