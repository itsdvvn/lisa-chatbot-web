---
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <title>Bank Sampah Tangsel & Edukasi 3R - Gerakan Bicara Lingkungan (LISA)</title>
        <meta name="description" content="Informasi 39 lokasi Bank Sampah di Tangerang Selatan (Tangsel) & edukasi 139+ jenis sampah 3R. Temukan titik bank sampah terdekat di wilayah Tangsel bersama AI LISA." />
        <meta name="keywords" content="Bank Sampah, Bank Sampah Tangsel, Bank Sampah Tangerang Selatan, Lokasi Bank Sampah Terdekat, Gerakan Bicara Lingkungan, GBL, Edukasi 3R, Daur Ulang Sampah Tangsel" />
        <meta name="author" content="Gerakan Bicara Lingkungan" />
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <link rel="canonical" href="https://lisa.itsdvvn.my.id/" />
        <meta name="theme-color" content="#006c4b" />
        <link rel="icon" type="image/webp" href="/images/logo-gbl.webp" />
        <link rel="apple-touch-icon" href="/images/lisa-avatar.webp" />
        <link rel="manifest" href="/manifest.json" />

        <!-- Open Graph / Facebook / WhatsApp -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://lisa.itsdvvn.my.id/" />
        <meta property="og:title" content="Bank Sampah Tangsel & Edukasi 3R - Gerakan Bicara Lingkungan" />
        <meta property="og:description" content="Panduan 39 titik lokasi Bank Sampah resmi di Tangerang Selatan dan edukasi pemilahan sampah cerdas bersama AI LISA." />
        <meta property="og:image" content="https://lisa.itsdvvn.my.id/images/hero-bg.webp" />
        <meta property="og:site_name" content="Gerakan Bicara Lingkungan" />
        <meta property="og:locale" content="id_ID" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content="https://lisa.itsdvvn.my.id/" />
        <meta name="twitter:title" content="Bank Sampah Tangsel & Edukasi 3R - Gerakan Bicara Lingkungan" />
        <meta name="twitter:description" content="Panduan 39 titik lokasi Bank Sampah di Tangerang Selatan bersama AI LISA." />
        <meta name="twitter:image" content="https://lisa.itsdvvn.my.id/images/hero-bg.webp" />

        <!-- Google Knowledge Graph & AI Overview Structured Data (JSON-LD) -->
        <script type="application/ld+json" is:inline>
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Organization",
              "@id": "https://lisa.itsdvvn.my.id/#organization",
              "name": "Gerakan Bicara Lingkungan",
              "alternateName": ["GBL", "Gerakan Bicara Lingkungan UBSI", "LISA GBL"],
              "url": "https://lisa.itsdvvn.my.id/",
              "logo": {
                "@type": "ImageObject",
                "url": "https://lisa.itsdvvn.my.id/images/logo-gbl.webp",
                "caption": "Logo Gerakan Bicara Lingkungan"
              },
              "areaServed": {
                "@type": "AdministrativeArea",
                "name": "Kota Tangerang Selatan",
                "addressCountry": "ID"
              },
              "description": "Gerakan Bicara Lingkungan (GBL) adalah komunitas edukasi kelestarian alam oleh mahasiswa Ilmu Komunikasi UBSI yang menghadirkan inovasi chatbot LISA untuk direktori Bank Sampah di wilayah Tangerang Selatan serta edukasi 3R.",
              "sameAs": [
                "https://www.instagram.com/gerakanbicaralingkungan_/",
                "https://github.com/itsdvvn/lisa-chatbot-web"
              ]
            },
            {
              "@type": "WebSite",
              "@id": "https://lisa.itsdvvn.my.id/#website",
              "url": "https://lisa.itsdvvn.my.id/",
              "name": "Direktori Bank Sampah Tangsel & Edukasi LISA",
              "description": "Platform resmi Gerakan Bicara Lingkungan untuk direktori Bank Sampah Tangerang Selatan dan Chatbot AI LISA",
              "publisher": { "@id": "https://lisa.itsdvvn.my.id/#organization" },
              "inLanguage": "id-ID"
            },
            {
              "@type": "SoftwareApplication",
              "@id": "https://lisa.itsdvvn.my.id/#software",
              "name": "LISA (Lingkungan Sehat dan Asri)",
              "applicationCategory": "EducationalApplication",
              "operatingSystem": "All",
              "url": "https://lisa.itsdvvn.my.id/chat",
              "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "IDR"
              },
              "description": "Asisten AI cerdas untuk klasifikasi jenis sampah, tutorial daur ulang 3R, dan penemu 39 titik lokasi bank sampah terdekat di wilayah Kota Tangerang Selatan (Ciputat, Pamulang, Serpong, dsk)."
            },
            {
              "@type": "FAQPage",
              "@id": "https://lisa.itsdvvn.my.id/#faq",
              "mainEntity": [
                {
                  "@type": "Question",
                  "name": "Apa itu Bank Sampah?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Bank sampah adalah tempat pengumpulan dan pemilahan sampah anorganik (kering) yang dikelola dengan sistem mirip perbankan, di mana masyarakat atau siswa dapat menabung sampah terpilah dan mendapatkan saldo rupiah atau nilai ekonomis."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Wilayah mana saja yang dicakup oleh direktori Bank Sampah LISA?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Saat ini direktori Bank Sampah LISA fokus melayani wilayah Kota Tangerang Selatan (Tangsel), mencakup 39 titik unit bank sampah aktif di kecamatan Ciputat, Ciputat Timur, Pamulang, Pondok Aren, Serpong, Serpong Utara, dan Setu."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Apa itu Gerakan Bicara Lingkungan (GBL)?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Gerakan Bicara Lingkungan (GBL) adalah komunitas aksi nyata anak muda yang diinisiasi oleh mahasiswa Ilmu Komunikasi UBSI untuk mengedukasi masyarakat dan siswa mengenai pengelolaan sampah, 3R, dan Bank Sampah di Tangerang Selatan."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Bagaimana cara menemukan Bank Sampah terdekat di Tangerang Selatan?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Cukup buka menu chat LISA di https://lisa.itsdvvn.my.id/chat lalu tanyakan 'Bank sampah di Ciputat' atau klik chip 'Bank Sampah'. LISA akan memberikan titik koordinat terdekat di Tangsel yang terhubung langsung ke rute Google Maps."
                  }
                },
                {
                  "@type": "Question",
                  "name": "Apakah saya bisa mengirimkan foto sampah untuk diperiksa?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Ya, di halaman chat tersedia tombol lampiran gambar. Kamu bisa memfoto sampah anorganik yang ingin kamu tanyakan jenis, estimasi nilai daur ulang, atau titik bank sampah penerimanya langsung ke AI LISA."
                  }
                }
              ]
            }
          ]
        }
        </script>

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-K8V9TQWP6X"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-K8V9TQWP6X');
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
            <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
        </noscript>

        <script is:inline>
            // Enforce Light Theme as strict default on all devices unless user explicitly switched to dark
            if (localStorage.getItem("lisaDarkMode") === "true") {
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.removeAttribute("data-theme");
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body class="bg-surface text-on-surface">
        <!-- SKIP LINK -->
        <a href="#main-content" class="skip-link" data-i18n="skip_link">Langsung ke konten utama</a>

        <div class="mx-auto min-h-screen bg-white dark:bg-surface relative overflow-x-hidden">
            <div class="max-w-6xl mx-auto">
                <!-- ========================= -->
                <!-- VIEW: HOME                -->
                <!-- ========================= -->
                <div id="view-home">
                    <!-- HEADER -->
                    <header class="sticky top-0 z-50 bg-white/90 dark:bg-surface/90 backdrop-blur-md border-b border-outline-variant/30 dark:border-white/10 px-6 py-4 flex justify-between items-center shadow-sm" id="header">
                        <div class="flex items-center gap-3 cursor-pointer group" onclick="navigateTo('home')">
                            <div class="w-12 h-12 bg-surface-container rounded-xl flex items-center justify-center shadow-sm overflow-hidden group-hover:scale-105 transition-transform">
                                <img alt="Logo GBL" class="w-10 h-10 object-contain" width="40" height="40" loading="eager" src="/images/logo-gbl.webp" />
                            </div>
                            <span class="font-display font-extrabold text-xl tracking-tight text-primary">LISA</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <!-- Quick Chat CTA Button in Header -->
                            <a href="/chat" onclick="trackGAEvent('click_cta_chat', { cta_location: 'header_nav' })" class="flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 bg-primary text-white text-xs sm:text-sm font-bold rounded-full shadow hover:bg-primary-variant hover:shadow-md transition active:scale-95">
                                <span class="material-symbols-outlined text-[16px] sm:text-[18px]">smart_toy</span>
                                <span class="hidden xs:inline-block sm:inline-block">Chat LISA</span>
                            </a>
                            <!-- Language toggle -->
                            <button id="langToggle" class="w-9 h-9 rounded-full bg-surface-container hover:bg-outline-variant/50 flex items-center justify-center text-xs font-bold text-on-surface-variant transition active:scale-90" aria-label="EN - Ganti Bahasa" title="Ganti bahasa">EN</button>
                            <!-- Dark mode toggle -->
                            <button id="darkModeToggle" class="w-9 h-9 rounded-full bg-surface-container hover:bg-outline-variant/50 flex items-center justify-center transition active:scale-90" aria-label="Mode Gelap">
                                <span class="material-symbols-outlined text-[20px] text-on-surface-variant">dark_mode</span>
                            </button>
                            <!-- Feedback trigger -->
                            <div class="flex items-center cursor-pointer group" id="subscribeTrigger">
                                <div class="flex items-center gap-2 px-3 sm:px-4 py-2 bg-primary/10 rounded-full text-primary hover:bg-primary/20 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">chat_bubble_outline</span>
                                    <span class="font-semibold text-sm hidden md:inline-block" data-i18n="feedback_title">Masukan</span>
                                </div>
                            </div>
                        </div>
                    </header>

                    <!-- HERO -->
                    <section class="relative pt-16 pb-24 px-6 text-center z-10 overflow-hidden" id="main-content">
                        <div class="absolute inset-0 z-0 h-[700px] hero-bg-mask pointer-events-none overflow-hidden">
                            <img alt="Hero Background" class="absolute inset-0 w-full h-[125%] -top-12 object-cover opacity-15 parallax" width="1200" height="800" fetchpriority="high" decoding="async" src="/images/hero-bg.webp" />
                        </div>
                        <div class="relative z-10 max-w-xl mx-auto flex flex-col items-center">
                            <button type="button" onclick="openArchiveModal()" class="hero-anim hero-anim-delay-1 inline-flex items-center gap-2 px-3.5 py-1.5 mb-6 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs font-bold hover:bg-amber-500/20 active:scale-95 transition-all cursor-pointer shadow-xs group">
                                <span class="text-sm shrink-0">🏆</span>
                                <span data-i18n="archive_badge_pill">Winner PR Awards 2025 • Info Arsip</span>
                                <span class="material-symbols-outlined text-[15px] shrink-0 opacity-70 group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
                            </button>
                            <h1 class="hero-anim hero-anim-delay-2 font-display text-6xl xl:text-7xl font-black text-primary mb-2 tracking-tight" data-i18n="hero_title">LISA</h1>
                            <div class="hero-anim hero-anim-delay-3 text-xl xl:text-2xl font-bold text-on-surface-variant mb-8 tracking-wide" data-i18n="hero_subtitle">
                                Lingkungan Sehat dan Asri
                            </div>
                            <p class="hero-anim hero-anim-delay-3 text-base xl:text-lg text-on-surface-variant leading-relaxed mb-6 font-medium max-w-md" data-i18n="hero_desc">
                                LISA membantu siswa memahami sampah dengan cara yang cepat dan jelas. Dibuat oleh mahasiswa Ilmu Komunikasi UBSI Ciledug x Ciputat, LISA merangkum data klasifikasi sampah, cara olah sederhana, dan lokasi bank sampah dalam satu percakapan praktis.
                            </p>
                            <p class="hero-anim hero-anim-delay-4 text-sm xl:text-base text-outline leading-relaxed mb-8 max-w-sm" data-i18n="hero_desc2">
                                                            Melalui edukasi singkat yang mudah diikuti, LISA mengajak siswa memulai kebiasaan bersih yang sederhana dan konsisten.
                                                        </p>
                            <div class="hero-anim hero-anim-delay-4 text-primary font-bold text-lg xl:text-xl mb-10 bg-primary/5 px-6 py-3 rounded-2xl inline-block border border-primary/10" data-i18n="hero_tagline">
                                Satu chat cukup untuk memulai perubahan.
                            </div>
                            <div class="hero-anim hero-anim-delay-5 flex flex-col w-full sm:flex-row gap-4 justify-center items-center max-w-md mx-auto">
                                <a class="w-full sm:w-auto bg-primary text-white font-bold py-4 px-8 rounded-full shadow-lg hover:bg-primary-variant hover:shadow-xl hover:-translate-y-1 transition-all flex items-center justify-center gap-2" href="/chat" onclick="trackGAEvent('click_cta_chat', { cta_location: 'hero_main' })">
                                    <span data-i18n="cta_chat">Mulai Chat</span>
                                    <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
                                </a>
                                <a class="w-full sm:w-auto bg-surface-container text-primary font-bold py-4 px-8 rounded-full hover:bg-outline-variant/30 transition-colors" href="#csr" data-i18n="cta_csr" onclick="trackGAEvent('click_cta_csr', { cta_location: 'hero' })">Program CSR</a>
                            </div>

                            <!-- STATS BADGES -->
                            <div class="hero-anim hero-anim-delay-5 mt-10 grid grid-cols-3 gap-3 w-full max-w-xl">
                                <div class="bg-white/80 dark:bg-surface-container border border-outline-variant/30 rounded-2xl p-3 shadow-sm text-center">
                                    <div class="text-xl sm:text-2xl font-black text-primary">139+</div>
                                    <div class="text-[11px] sm:text-xs text-on-surface-variant font-medium mt-0.5">Panduan Sampah 3R</div>
                                </div>
                                <div class="bg-white/80 dark:bg-surface-container border border-outline-variant/30 rounded-2xl p-3 shadow-sm text-center">
                                    <div class="text-xl sm:text-2xl font-black text-primary">39</div>
                                    <div class="text-[11px] sm:text-xs text-on-surface-variant font-medium mt-0.5">Bank Sampah Tangsel</div>
                                </div>
                                <div class="bg-white/80 dark:bg-surface-container border border-outline-variant/30 rounded-2xl p-3 shadow-sm text-center">
                                    <div class="text-xl sm:text-2xl font-black text-primary">100%</div>
                                    <div class="text-[11px] sm:text-xs text-on-surface-variant font-medium mt-0.5">Akses Gratis</div>
                                </div>
                            </div>

                            <!-- INTERACTIVE CHAT PREVIEW CARD -->
                            <div class="hero-anim hero-anim-delay-5 mt-8 w-full max-w-md bg-white dark:bg-surface-container rounded-3xl p-5 shadow-xl border border-outline-variant/30 text-left relative overflow-hidden group">
                                <div class="flex items-center justify-between pb-3 border-b border-outline-variant/20 mb-3">
                                    <div class="flex items-center gap-2.5">
                                        <div class="relative">
                                            <img src="/images/lisa-avatar.webp" alt="LISA Avatar" width="32" height="32" class="w-8 h-8 rounded-full object-cover border border-primary/20" />
                                            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-green-500 border-2 border-white"></span>
                                        </div>
                                        <div>
                                            <div class="text-xs font-bold text-on-surface">Simulasi Obrolan LISA</div>
                                            <p class="text-[10px] text-primary font-medium">Online • Siap bantu wilayah Tangsel</p>
                                        </div>
                                    </div>
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold text-primary bg-primary/10 px-2.5 py-0.5 rounded-full">Tangsel AI</span>
                                </div>
                                
                                <div class="space-y-2.5 text-xs">
                                    <!-- User snippet -->
                                    <div class="flex justify-end">
                                        <div class="bg-primary text-white px-3.5 py-2 rounded-2xl rounded-tr-none max-w-[85%] shadow-sm">
                                            LISA, ada bank sampah aktif di sekitar Ciputat / Pamulang? 📍
                                        </div>
                                    </div>
                                    <!-- Bot snippet -->
                                    <div class="flex justify-start">
                                        <div class="bg-surface-container/70 dark:bg-surface text-on-surface px-3.5 py-2.5 rounded-2xl rounded-tl-none max-w-[90%] border border-outline-variant/20 shadow-sm leading-relaxed">
                                            Ada! Di Ciputat ada <b>Bank Sampah Teratai</b> & <b>Bank Sampah Kasih Ibu</b>. Aku bisa kasih titik rute Google Maps-nya yaa 🗺️✨
                                        </div>
                                    </div>
                                </div>

                                <!-- Mini CTA to open Chat -->
                                <a href="/chat" onclick="trackGAEvent('click_cta_chat', { cta_location: 'chat_simulation_card' })" class="mt-4 w-full py-2.5 bg-primary/10 hover:bg-primary hover:text-white text-primary text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 group-hover:bg-primary group-hover:text-white">
                                    <span>Cari Bank Sampah Tangsel di LISA</span>
                                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                                </a>
                            </div>

                            <!-- Install App button (hidden by default) -->
                            <button id="installAppBtn" class="hero-anim hero-anim-delay-5 mt-4 hidden items-center gap-2 text-sm font-semibold text-primary bg-primary/5 px-4 py-2 rounded-full border border-primary/20 hover:bg-primary/10 transition-colors" style="display:none">
                                <span class="material-symbols-outlined text-[18px]">download</span>
                                <span data-i18n="install_app">Install App</span>
                            </button>
                        </div>
                    </section>

                    <!-- CSR CARDS -->
                    <section class="pt-16 pb-24 px-6 bg-surface-container/50 rounded-t-[3rem]" id="csr">
                        <div class="max-w-6xl mx-auto flex flex-col items-center">
                            <div class="text-center mb-12">
                                <h2 class="font-display text-3xl font-extrabold text-primary mb-3 reveal" data-i18n="csr_title">Program CSR Kami</h2>
                                <p class="text-on-surface-variant text-sm reveal reveal-delay-1" data-i18n="csr_subtitle">Langkah nyata untuk lingkungan yang lebih baik.</p>
                            </div>
                            <div class="csr-stack flex flex-col gap-4 xl:flex-row xl:gap-6 xl:pb-0 w-full max-w-5xl">
                                <div class="csr-card-1 bg-csr-orange text-white p-8 rounded-[2rem] shadow-lg relative overflow-hidden group hover:-translate-y-2 transition-transform duration-300 xl:flex-1 reveal reveal-delay-1">
                                    <div class="absolute top-0 right-0 p-6 opacity-20 transform translate-x-4 -translate-y-4 group-hover:scale-110 transition-transform xl:top-8 xl:translate-y-0">
                                        <span class="material-symbols-outlined text-6xl">campaign</span>
                                    </div>
                                    <h3 class="font-bold text-xl mb-3 relative z-10" data-i18n="csr_card1_title">Edukasi Sampah Era Digital</h3>
                                                                        <p class="text-sm leading-relaxed opacity-90 relative z-10" data-i18n="csr_card1_desc">Memberikan pengetahuan dasar mengenai pengurangan sampah dan penerapan 3R melalui media digital seperti Instagram dan Tiktok.</p>
                                </div>
                                <div class="csr-card-2 bg-csr-green text-white p-8 rounded-[2rem] shadow-xl relative overflow-hidden group hover:-translate-y-2 transition-transform duration-300 xl:flex-1 xl:pt-8 reveal reveal-delay-2">
                                    <div class="absolute top-0 right-0 p-6 opacity-20 transform translate-x-4 group-hover:scale-110 transition-transform xl:top-8">
                                        <span class="material-symbols-outlined text-6xl">groups</span>
                                    </div>
                                    <h3 class="font-bold text-xl mb-3 relative z-10" data-i18n="csr_card2_title">Seminar Edukasi Lingkungan</h3>
                                                                        <p class="text-sm leading-relaxed opacity-90 relative z-10" data-i18n="csr_card2_desc">Kegiatan seminar langsung untuk memperdalam pemahaman masyarakat mengenai pengelolaan sampah dan 3R.</p>
                                </div>
                                <div class="csr-card-3 bg-white dark:bg-surface-container border border-outline-variant/30 text-on-surface p-8 rounded-[2rem] shadow-2xl relative overflow-hidden group hover:-translate-y-2 transition-transform duration-300 xl:flex-1 xl:pt-8 reveal reveal-delay-3">
                                    <div class="absolute top-0 right-0 p-6 opacity-10 text-primary transform translate-x-4 group-hover:scale-110 transition-transform xl:top-8">
                                        <span class="material-symbols-outlined text-6xl">smart_toy</span>
                                    </div>
                                    <h3 class="font-bold text-xl text-primary mb-3 relative z-10" data-i18n="csr_card3_title">Chatbot AI Lisa</h3>
                                                                        <p class="text-sm text-on-surface-variant leading-relaxed relative z-10" data-i18n="csr_card3_desc">Fasilitas digital yang dapat membantu masyarakat mendapatkan informasi praktis mengenai sampah, 3R dan Bank Sampah.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- BEHIND LISA -->
                    <section class="py-24 px-6 bg-white dark:bg-surface relative overflow-hidden reveal">
                        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
