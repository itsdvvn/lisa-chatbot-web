<div class="flex-1 overflow-y-auto p-4 space-y-4" id="chatbox">
  <!-- Welcome Card -->
  <div id="welcomeCard" class="text-center py-6 px-4 bg-surface-container/40 dark:bg-surface-container-low/40 rounded-3xl border border-outline-variant/30 my-4">
    <img alt="LISA Profile" class="w-16 h-16 rounded-full mx-auto mb-3 border-2 border-primary/20 shadow-md" width="64" height="64" src="/images/lisa-avatar.webp" />
    <h2 class="font-black text-lg text-on-surface mb-1">Hai! Aku LISA 👋</h2>
    <p class="text-xs text-outline leading-relaxed max-w-xs mx-auto mb-4">
      Asisten AI lingkungan sekolah. Tanya apa saja seputar klasifikasi sampah, 3R, dan Bank Sampah!
    </p>
    
    <div class="flex flex-wrap justify-center gap-2">
      <button class="quick-chip" data-send="Jelaskan apa itu prinsip 3R">Apa itu 3R?</button>
      <button class="quick-chip" data-send="Bagaimana cara pilah sampah organik?">Pilah Sampah</button>
      <button class="quick-chip" data-send="Di mana bank sampah terdekat?">Bank Sampah</button>
    </div>
  </div>
</div>
